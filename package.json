{
  "name": "nexus",
  "productName": "Nexus",
  "version": "0.2.0",
  "description": "Nexus - desktop management app for Discord league owners and staff",
  "private": true,
  "author": "Nexus",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "vite --config vite.mock.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/check-no-mock.mjs pre && electron-vite build && node scripts/check-no-mock.mjs post",
    "dist": "npm run build && electron-builder --win --x64",
    "icon": "node scripts/generate-icon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/orbitron": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
